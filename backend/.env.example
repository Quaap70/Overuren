# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secrets (wijzig deze in productie!)
JWT_SECRET=jouw-super-geheime-jwt-secret-key-hier
REFRESH_SECRET=jouw-super-geheime-refresh-secret-key-hier

# Database
DB_PATH=./database.sqlite

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=jouw-email@gmail.com
EMAIL_PASSWORD=jouw-app-wachtwoord
EMAIL_FROM=Overuren Systeem <noreply@overuren.nl>

# Frontend URL (voor emails)
FRONTEND_URL=http://localhost:3000

# CORS Origins (voor netwerk toegang)
CORS_ORIGIN=http://localhost:3000
